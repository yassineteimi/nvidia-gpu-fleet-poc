# Copy to .env and fill in. .env is gitignored and must never be committed.

# Scaleway API credentials, from https://console.scaleway.com/iam/api-keys
SCW_ACCESS_KEY=""
SCW_SECRET_KEY=""
SCW_DEFAULT_PROJECT_ID=""
SCW_DEFAULT_ORGANIZATION_ID=""

# The zone and region are NOT set here. They live in terraform/terraform.tfvars
# and nowhere else. The Scaleway provider lets SCW_DEFAULT_ZONE in the
# environment override the zone in its own configuration, so setting it here
# means switching terraform.tfvars to the pl-waw-2 fallback would silently do
# nothing. If your .env still has SCW_DEFAULT_ZONE or SCW_DEFAULT_REGION,
# delete those lines.

# The SSH keypair used for both nodes. Set the PRIVATE key only. The scripts
# derive the public key from it and hand that to Terraform, so there is no
# second path to keep in sync and no way to register one key and log in with
# another.
#
# ed25519 is the right default on Ubuntu 22.04. An existing RSA key will work,
# the scripts just say so on the way past. To make a fresh one scoped to this
# project rather than reusing your everyday key:
#
#   ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519_gpu_fleet -C gpu-fleet-poc
#
SSH_PRIVATE_KEY_PATH="$HOME/.ssh/id_ed25519"

# Container registry for the gpu-remediator image (Session C).
GHCR_USER="yassineteimi"
GHCR_TOKEN=""
