#!/usr/bin/env bash
#
# GPU node bootstrap. Runs once, on first boot, as cloud-init user data.
#
# This node deliberately installs no NVIDIA software at all. No driver, no
# container toolkit, no CUDA, no DKMS, nothing. It boots a plain Ubuntu image
# and stops at a kubeadm ready state. Everything NVIDIA arrives later, from the
# GPU Operator, driven by ArgoCD from Git. That is the capability this PoC
# exists to demonstrate, and pre-baking any of it on the image would quietly
# delete the demonstration.
#
# The node does not join the cluster here either. Joining needs a token, and a
# token that lived in Git or in Terraform state would be a token committed to a
# public repository. scripts/gpu-up.sh asks the control plane for a fresh one
# after this script has finished.
#
set -euo pipefail
exec > >(tee -a /var/log/gpu-fleet-bootstrap.log) 2>&1

${common}

########################################
# Assert the image is clean
#
# A Scaleway GPU OS image ships the driver and the container toolkit
# preinstalled. Booting one by accident would not fail loudly: the GPU would
# work, pods would see it, and the driver lifecycle story would be a fiction.
# Terraform already refuses a gpu_os image label, and this is the second gate,
# on the node itself, checking the result rather than the intent.
########################################

if command -v nvidia-smi >/dev/null 2>&1 \
  || [ -e /dev/nvidia0 ] \
  || lsmod | grep -q '^nvidia'; then
  log "FATAL: this image already carries an NVIDIA driver"
  log "The GPU Operator must own the driver lifecycle. Boot a plain Ubuntu image."
  exit 1
fi

log "no NVIDIA driver present, as intended"
lspci -nn | grep -i nvidia || log "no NVIDIA PCI device reported by lspci"

########################################
# Ready to be joined
#
# Pulling the control plane images now costs nothing while the node is idle and
# takes a minute off the join later, which matters when the node is billed by
# the hour.
########################################

kubeadm config images pull --cri-socket unix:///run/containerd/containerd.sock || true

touch /var/lib/gpu-fleet/bootstrap-complete
log "GPU node bootstrap complete, waiting to be joined"
